# Frontend (copied into the Vite build; publishable values only)
VITE_KODA_AUTH_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (Render runtime; never expose a service-role key to Vite)
KODA_AUTH_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
KODA_SANDBOX_BUCKET=koda-sandbox
KODA_CORS_ORIGINS=http://localhost:5173,https://koda-practice.onrender.com
